#!/bin/sh
# postinst script for octoka
#
# see: dh_installdeb(1)

set -e

OCTOKA_CONFIG=/etc/octoka
OCTOKA_LOG=/var/log/octoka

OCTOKA_GROUP=octoka
OCTOKA_GID=7969
OCTOKA_USER=octoka
OCTOKA_UID=7969

# summary of how this script can be called:
#    * <postinst> `configure' <most-recently-configured-version>
#    * <old-postinst> `abort-upgrade' <new version>
#    * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#      <new-version>
#    * <postinst> `abort-remove'
#    * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#      <failed-install-package> <version> `removing'
#      <conflicting-package> <version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

create_group() {
  if ! getent group $OCTOKA_GROUP > /dev/null 2>&1; then
    addgroup --gid $OCTOKA_GID $OCTOKA_GROUP
  fi
}

create_user() {
  if ! getent passwd $OCTOKA_USER > /dev/null 2>&1; then
    adduser --system --no-create-home --uid $OCTOKA_UID --ingroup $OCTOKA_GROUP \
        --disabled-login --disabled-password --shell /usr/sbin/nologin $OCTOKA_USER
  fi
}

apply_permissions() {
  #If $1 is *not* a mount, apply the dpkg-statoverride
  findmnt -M "$1" 2>&1 > /dev/null && export isMount="true" || export isMount="false"
  dpkg-statoverride --list "$1" 2>&1 > /dev/null && export isOverridden="true" || export isOverridden="false"
  if ! $isMount && ! $isOverridden; then
    dpkg-statoverride --update --add $OCTOKA_USER $OCTOKA_GROUP 755 $1
  fi
  if ! $isMount; then
    #This chown is required, dpkg-statoverride does not recurse and apply the change to the children
    chown -R $OCTOKA_USER:$OCTOKA_GROUP $1
  fi
}

case "$1" in
  configure)
    create_group
    create_user

    apply_permissions $OCTOKA_CONFIG
    apply_permissions $OCTOKA_LOG

    systemctl enable octoka.service
    systemctl start octoka.service
  ;;

  abort-upgrade|abort-remove|abort-deconfigure)
  ;;

  *)
    echo "postinst called with unknown argument \`$1'" >&2
    exit 1
  ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
