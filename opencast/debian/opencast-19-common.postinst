#!/bin/sh
# postinst script for opencast
#
# see: dh_installdeb(1)

set -e

OC_HOME=/usr/share/opencast
OC_CONFIG=/etc/opencast
OC_DATA=/srv/opencast
OC_KARAF_DATA=/var/lib/opencast
OC_LOG=/var/log/opencast

OC_GROUP=opencast
OC_GID=7967
OC_USER=opencast
OC_UID=7967

# summary of how this script can be called:
#    * <postinst> `configure' <most-recently-configured-version>
#    * <old-postinst> `abort-upgrade' <new version>
#    * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#      <new-version>
#    * <postinst> `abort-remove'
#    * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#      <failed-install-package> <version> `removing'
#      <conflicting-package> <version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

create_group() {
  if ! getent group $OC_GROUP > /dev/null 2>&1; then
    addgroup --gid $OC_GID $OC_GROUP
  fi
}

create_user() {
  if ! getent passwd $OC_USER > /dev/null 2>&1; then
    adduser --system --no-create-home --uid $OC_UID --ingroup $OC_GROUP \
        --disabled-login --disabled-password --home $OC_HOME --shell /usr/sbin/nologin $OC_USER
  fi
}

apply_rw_permissions() {
  target="$1"

  # Reading more about this, package maintainers are supposed to use normal chown/chmod, *not* dpkg-statoverride
  # Given that all the old deb use dpkg-statoverride, we lead this with a removal so that (eventually) they all go away
  dpkg-statoverride --list "$target" > /dev/null 2>&1 && dpkg-statoverride --quiet --remove "$target"

  findmnt -M "$target" > /dev/null 2>&1 && export isMount="true" || export isMount="false"
  # Remove any override for this path
  if ! $isMount; then
    # Previous packaging allowed r/w by default, so we set the top level (ie, the constants above) permissions
    # but we don't recurse downwards since we don't need to.  If this is a new install it won't matter, and if
    # it's an *old* install then this could be a *very* long process if there are a ton of files
    chmod 750 "$target"
    chown $OC_USER:$OC_GROUP "$target"
  fi
}

apply_ro_permissions() {
  target="$1"

  # Reading more about this, package maintainers are supposed to use normal chown/chmod, *not* dpkg-statoverride
  # Given that all the old deb use dpkg-statoverride, we lead this with a removal so that (eventually) they all go away
  dpkg-statoverride --list "$target" > /dev/null 2>&1 && dpkg-statoverride --quiet --remove "$target"

  findmnt -M "$target" > /dev/null 2>&1 && export isMount="true" || export isMount="false"
  if ! $isMount; then
    # Previous packaging allowed r/w by default, but here we are specifying that these files *must* be RO.
    # So we do this in two steps, one for each type of file, and recursively
    # And we lock it to root:opencast with opencast having only read perms
    find "$target" -type d -exec chmod 750 "{}" \;
    find "$target" -type f -exec chmod 640 "{}" \;
    chown -R root:$OC_GROUP "$target"
  fi
}

case "$1" in
  configure)
    create_group
    create_user

    mkdir -p $OC_DATA

    # OC_HOME and OC_CONFIG should both be read-only
    apply_ro_permissions $OC_HOME
    apply_ro_permissions $OC_CONFIG

    # The rest are places where Opencast is allowed to make modifications
    apply_rw_permissions $OC_LOG
    apply_rw_permissions $OC_DATA
    apply_rw_permissions $OC_KARAF_DATA

    # Enforce executable permissions on the start/stop scripts
    chmod 750 $OC_HOME/bin/start-opencast
    chmod 750 $OC_HOME/bin/stop-opencast
    # Fix the ownership of these two directories.  They're burned into the packages with root:root otherwise
    chown -R $OC_USER:$OC_GROUP $OC_KARAF_DATA/data $OC_KARAF_DATA/instances
  ;;

  abort-upgrade|abort-remove|abort-deconfigure)
  ;;

  *)
    echo "postinst called with unknown argument \`$1'" >&2
    exit 1
  ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
