#!/usr/bin/dh-exec

build/bin/whisper-bench => /usr/bin/whisper-bench
build/bin/whisper-cli => /usr/bin/whisper-cli
build/bin/whisper-server => /usr/bin/whisper-server

build/bin/libwhisper.so.WHISPER_VERSION => /usr/lib/libwhisper.so.WHISPER_VERSION
build/bin/libggml.so => /usr/lib/libggml.so
build/bin/libggml-base.so => /usr/lib/libggml-base.so
build/bin/libggml-cpu.so => /usr/lib/libggml-cpu.so

models/download-ggml-model.sh => /usr/sbin/whisper-ggml-model-download
